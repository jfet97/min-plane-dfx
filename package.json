{
  "name": "min-plane-dfx",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop app for preparing DXF rectangular nesting jobs",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm native:electron && pnpm build:worker && electron-vite dev",
    "build": "electron-vite build && vite build --config vite.worker.config.ts",
    "build:renderer": "electron-vite build",
    "build:worker": "vite build --config vite.worker.config.ts",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "native:electron": "electron-rebuild -f -w better-sqlite3",
    "test": "pnpm native:electron && ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:focused": "ELECTRON_RUN_AS_NODE=1 pnpm exec electron ./node_modules/vitest/vitest.mjs run",
    "test:watch": "pnpm native:electron && ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "benchmark:irregular": "tsx --tsconfig tsconfig.node.json scripts/irregular-benchmark.ts",
    "corpus:sheet-invariance": "tsx --tsconfig tsconfig.node.json scripts/irregular-sheet-invariance.ts",
    "gate:mixed61-compact": "pnpm corpus:sheet-invariance --case mixed-61 --sheets 2000x2700 --allow-single-sheet --strict --expected-canonical-sha256 ef2b783ae12491d2a80a12ef94d1bb2801c13cbd43aeb6e2c1cc00d86828fd3b --maximum-area-mm2 391606 --maximum-canonical-cavities 0 --maximum-elapsed-ms 330000",
    "postinstall": "pnpm native:electron"
  },
  "dependencies": {
    "@effect/atom-vue": "^4.0.0-beta.88",
    "@effect/platform-browser": "^4.0.0-beta.88",
    "@effect/platform-node": "4.0.0-beta.89",
    "@effect/sql-sqlite-node": "4.0.0-beta.89",
    "clipper2-ts": "2.0.1-18",
    "dxf-parser": "^1.1.2",
    "effect": "^4.0.0-beta.88",
    "iconv-lite": "^0.7.2",
    "robust-predicates": "3.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "3.6.1",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.16.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.1.10"
  }
}
