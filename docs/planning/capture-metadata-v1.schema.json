{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capture-metadata-v1.schema.json",
  "title": "Old Rust parity capture metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "acceptedEngineRevision",
    "sourceProvenanceRevision",
    "target",
    "toolchain",
    "artifactName",
    "build",
    "rustc",
    "cargo",
    "sourceCargoLockSha256",
    "nativeDependencies",
    "addon",
    "workflow",
    "corpus",
    "raw"
  ],
  "properties": {
    "version": { "const": 1 },
    "acceptedEngineRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceProvenanceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "target": {
      "enum": [
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
        "aarch64-apple-darwin",
        "x86_64-apple-darwin"
      ]
    },
    "toolchain": { "const": "1.95.0" },
    "artifactName": { "type": "string", "pattern": "^old-rust-parity-capture-" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "features"],
      "properties": {
        "profile": { "const": "release" },
        "features": { "const": [] }
      }
    },
    "rustc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "verbose"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "verbose": { "type": "string", "minLength": 1 }
      }
    },
    "cargo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity"],
      "properties": { "identity": { "type": "string", "minLength": 1 } }
    },
    "sourceCargoLockSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nativeDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "sha256"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "addon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["historicalSha256", "freshSha256"],
      "properties": {
        "historicalSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "freshSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "sha", "runId", "runAttempt"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "runId": { "type": "string", "minLength": 1 },
        "runAttempt": { "type": "string", "minLength": 1 }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestName", "manifestSha256", "sha256SumsSha256", "rowIds"],
      "properties": {
        "manifestName": { "const": "migration-corpus.json" },
        "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sha256SumsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "rowIds": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "uniqueItems": true,
          "items": {
            "enum": [
              "triangle-20-2000x2700-compact",
              "triangle-20-2000x2700-short-side",
              "triangle-20-600x400-compact",
              "triangle-20-600x400-short-side",
              "triangle-20-300x300-compact",
              "triangle-20-300x300-short-side",
              "mixed-61-2000x2700-compact",
              "mixed-61-2000x2700-short-side",
              "mixed-61-600x400-compact",
              "mixed-61-600x400-short-side",
              "mixed-61-300x300-compact",
              "mixed-61-300x300-short-side",
              "shapes-17-2000x2700-compact",
              "shapes-17-2000x2700-short-side",
              "shapes-17-600x400-compact",
              "shapes-17-600x400-short-side",
              "shapes-17-300x300-compact",
              "shapes-17-300x300-short-side"
            ]
          }
        }
      }
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "files"],
      "properties": {
        "version": { "const": 1 },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "size"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[^/]+/(?:request|result|events|stderr|process)\\.(?:json|ndjson|txt)$"
              },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "size": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
